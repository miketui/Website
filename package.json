{
  "name": "@curls/author-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/check-prod-env.mjs && next build",
    "security:audit": "pnpm audit --prod --audit-level=high",
    "check:prod-env": "node scripts/check-prod-env.mjs",
    "check:sandbox-env": "node scripts/check-sandbox-env.mjs",
    "check:deliverables": "node scripts/check-public-deliverables.mjs",
    "check:supabase-storage": "node scripts/verify-supabase-storage-paths.mjs",
    "check:stripe-test": "node scripts/stripe-test-mode-check.mjs",
    "check:sandbox": "pnpm check:sandbox-env && pnpm check:deliverables && pnpm check:supabase-storage && pnpm check:stripe-test",
    "check:checkout": "node scripts/checkout-smoke-test.mjs",
    "browser:install": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium",
    "audit:a11y": "node scripts/a11y-audit.mjs",
    "qa:mobile": "node scripts/mobile-qa.mjs",
    "upload:deliverables": "node scripts/upload-deliverables.mjs",
    "generate:motion-posters": "node scripts/gen-motion-posters.mjs",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test tests/e2e-scroll.spec.ts",
    "test:a11y": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright test tests/a11y.spec.ts"
  },
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0 <11"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.62.0",
    "@stripe/stripe-js": "^9.12.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.9",
    "@vercel/speed-insights": "^2.0.0",
    "clsx": "^2.1.1",
    "motion": "^12.42.2",
    "next": "^16.2.11",
    "posthog-js": "^1.407.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "stripe": "^22.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^30.0.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": ">=8.5.18",
      "dompurify@<3.4.12": ">=3.4.12",
      "fast-uri@<3.1.4": ">=3.1.4",
      "sharp@<0.35.0": ">=0.35.0",
      "undici@<7.28.0": ">=7.28.0",
      "js-yaml@<4.3.0": ">=4.3.0"
    }
  }
}
